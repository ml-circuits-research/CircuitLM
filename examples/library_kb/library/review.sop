@x kernel.logic.variable name "item"
@p0 sem.term predicate "return_reminder" subject $x
@body kernel.seq.make item $p0
@head sem.term predicate "loan_review" subject $x
@source kernel.value.record source "examples/library-manual.txt" hash "0e45c6a74c5fcb80bbad2a55" start 85 end 163 quote "Within this example, an item that needs a return reminder needs a loan review."
@rule kernel.value.record id "library.review" body $body head $head source $source
@output result $rule
