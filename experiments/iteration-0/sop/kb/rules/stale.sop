@x kernel.logic.variable name "entity"
@p0 sem.term predicate "cache" subject $x polarity "positive"
@p1 sem.term predicate "ttl" subject $x polarity "positive"
@p2 sem.term predicate "invalidates" subject $x polarity "negative"
@body kernel.seq.make item $p0 item $p1 item $p2
@head sem.term predicate "stale_risk" subject $x
@source kernel.value.record source "examples/manual.txt" hash "9fb102f9d41a1894e54c9ee2" start 450 end 578 quote "Within this model, a cache that has an expiration limit and does not invalidate entries after updates has a risk of stale reads."
@rule kernel.value.record id "kb.rules.stale" body $body head $head source $source
@output result $rule
