@x kernel.logic.variable name "entity"
@p0 sem.term predicate "duplicate_risk" subject $x polarity "positive"
@body kernel.seq.make item $p0
@head sem.term predicate "dedup_review" subject $x
@source kernel.value.record source "examples/manual.txt" hash "9fb102f9d41a1894e54c9ee2" start 134 end 229 quote "Within this model, a risk of duplicate records requires a review of the deduplication strategy."
@rule kernel.value.record id "kb.rules.dedup_review" body $body head $head source $source
@output result $rule
