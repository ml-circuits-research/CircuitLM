@x kernel.logic.variable name "entity"
@p0 sem.term predicate "worker" subject $x polarity "positive"
@p1 sem.term predicate "early_ack" subject $x polarity "positive"
@p2 sem.term predicate "volatile" subject $x polarity "positive"
@body kernel.seq.make item $p0 item $p1 item $p2
@head sem.term predicate "loss_risk" subject $x
@source kernel.value.record source "examples/manual.txt" hash "9fb102f9d41a1894e54c9ee2" start 230 end 360 quote "Within this model, a worker that acknowledges messages before persisting them and uses volatile memory has a risk of message loss."
@rule kernel.value.record id "kb.rules.loss" body $body head $head source $source
@output result $rule
