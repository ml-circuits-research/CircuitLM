@x kernel.logic.variable name "entity"
@p0 sem.term predicate "loss_risk" subject $x polarity "positive"
@body kernel.seq.make item $p0
@head sem.term predicate "durability_review" subject $x
@source kernel.value.record source "examples/manual.txt" hash "9fb102f9d41a1894e54c9ee2" start 361 end 449 quote "Within this model, a risk of message loss requires a review of the persistence strategy."
@rule kernel.value.record id "kb.rules.durability_review" body $body head $head source $source
@output result $rule
